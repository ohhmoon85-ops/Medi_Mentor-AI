# medimentor Care 환경 변수 예시
# - 본 파일은 배포자 가이드용 템플릿입니다. 실제 값은 .env.local 에 작성하세요.
# - .env.local 은 .gitignore 처리되어 커밋되지 않습니다.
# - PII 및 실제 API 키를 본 파일에 절대 입력하지 마세요.

# ──────────────────────────────────────────────────────────────
# Alpha 코드 게이팅 (G1-5 / kill switch 후보 A — v13 §3.2 D-3 정합)
# ──────────────────────────────────────────────────────────────
# 알파 5명 코드를 콤마 구분으로 입력합니다.
# 차단 시 빈 문자열 또는 미설정으로 토글 → 모든 알파 진입 차단.
ALPHA_USER_CODES=alpha-001,alpha-002,alpha-003,alpha-004,alpha-005

# ──────────────────────────────────────────────────────────────
# LLM fallback 모드 (G2-3 RealRoutingAdapter / D-3 정합)
# ──────────────────────────────────────────────────────────────
# false: mock 모드. LLM 호출 0건, 비용 $0. 알파 검증·시뮬레이션 기본값.
# true:  실 LLM 호출. ALPHA-0 단계 사용자 결정 후 활성화.
USE_LLM_FALLBACK=false

# ──────────────────────────────────────────────────────────────
# LLM API 키 (USE_LLM_FALLBACK=true 시에만 필요)
# ──────────────────────────────────────────────────────────────
# Anthropic Claude (triage, ddx, llm-fallback, hallucination-guard, RAG generate)
ANTHROPIC_API_KEY=

# OpenAI (RAG embed only)
OPENAI_API_KEY=

# ──────────────────────────────────────────────────────────────
# Vercel Blob (동의 영속 저장 — G3-3 A안 마이그레이션)
# ──────────────────────────────────────────────────────────────
# Vercel Dashboard → Storage → Blob → Create Store + Token (read+write) 으로 발급.
# Vercel 배포 환경에서는 환경 변수에 자동 주입되므로 로컬 개발 시에만 본 변수 명시 필요.
# 누락 시 submitConsent 의 put() 호출이 try/catch 로 흡수되어 동의 흐름 무영향.
# G3-4 추가: 메트릭 N1 (POST /api/care/metrics) 동일 토큰 재사용 — pathname = metrics/<metric_type>.jsonl (NDJSON)
BLOB_READ_WRITE_TOKEN=

# ──────────────────────────────────────────────────────────────
# N3 피드백 진입점 — Tally 폼 URL (G1-3 FeedbackEntryButton)
# ──────────────────────────────────────────────────────────────
# 첫 진입 이후 경과 일수 기준 A/B/C 분기 (UI 노출 분기).
# 미설정 시 FeedbackEntryButton 자체가 null 반환(비표시) → 안전.
NEXT_PUBLIC_TALLY_FEEDBACK_URL_A=
NEXT_PUBLIC_TALLY_FEEDBACK_URL_B=
NEXT_PUBLIC_TALLY_FEEDBACK_URL_C=

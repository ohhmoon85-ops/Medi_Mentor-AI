# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# G1-4 메트릭 로그 (알파 단계 임시, 공개 출시 시 DB로 교체)
/logs/metrics/

# G1-5 동의 기록 로그
/logs/consent/

# G1-1 검증 보고서 (디렉토리는 추적, 보고서 파일만 제외)
/docs/alpha/validation_reports/*.json
